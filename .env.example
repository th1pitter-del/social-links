# Copy to .env and fill in real values. Never commit the filled-in file.

# --- Database -----------------------------------------------------------------
# MySQL 8.4 (Laragon locally). Prisma reads this via prisma.config.ts.
DATABASE_URL="mysql://root:@localhost:3306/social_links"

# --- Better Auth --------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Public origin used to build shareable unlock links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Runtime configuration (fallbacks) ----------------------------------------
# Everything below is configured in /admin/settings and takes effect without a
# redeploy. These variables are only consulted while no setting row exists yet,
# so an install seeded by the platform environment keeps working. Saving a value
# in the panel — even an empty one — makes the database authoritative.
#
# The variables above stay here because the app needs them before it can read
# the database: the connection string, the signing secret, the origin baked into
# the browser bundle and the upload directory.
#
# Email delivery (admin > Email delivery): password reset emails are POSTed as
# JSON to a webhook (relay, automation or transactional provider). Without it,
# reset links are only logged in development.
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_TOKEN=""
EMAIL_FROM="Link Unlocker <no-reply@example.com>"

# Retention (admin > Data retention): how long to keep analytics events
# (0 = keep forever).
RETENTION_ANALYTICS_DAYS="0"

# Step verification (admin > Step verification):
# verification.githubToken — GitHub verification works without it, but anonymous
# requests are capped at 60/hour per server egress IP. A classic token raises
# that to 5000/hour.
VERIFIER_GITHUB_TOKEN=""

# verification.telegramBotToken — the token BotFather gives you. The bot must be
# an administrator of the channel, and no webhook may be set on it, because the
# app reads the check-in queue with getUpdates.
TELEGRAM_BOT_TOKEN=""

# verification.steamWebApiKey — free at steamcommunity.com/dev/apikey (needs a
# non-limited account with Steam Guard). Anonymous Steam calls are refused, and
# a key is capped near 100 calls per 5 minutes for all visitors combined.
STEAM_WEB_API_KEY=""

# verification.youtubeApiKey — free at console.cloud.google.com: enable YouTube
# Data API v3 and create an API key. Comment steps are proven by reading the
# video's public comments; the default quota is 10,000 units/day and one check
# uses one unit per handle lookup plus one per page of comments read.
YOUTUBE_API_KEY=""

# verification.discordBotToken — the token of a bot you created at
# discord.com/developers and invited to your server. Reading members needs no
# privileged intent.
DISCORD_BOT_TOKEN=""

# verification.discordGuildId — optional. Left empty, the server is taken from
# the invite link pasted on the unlock step.
DISCORD_GUILD_ID=""

# verification.twitchClientId / twitchClientSecret — from an application you
# registered at dev.twitch.tv/console. There is no env fallback: they are saved
# in the panel, and the owner approves access once there too, because Twitch
# only answers a follower lookup for the channel that granted the token.

# --- Uploads ------------------------------------------------------------------
# Directory for uploaded cover images (relative to the project root). Bytes are
# written to disk; metadata lives in the MediaAsset table. The admin-managed
# `limits.uploadMaxMb` setting controls the per-file size limit.
MEDIA_STORAGE_DIR=".uploads"

# --- Admin bootstrap ----------------------------------------------------------
# Used by `npm run db:seed` to create/promote the first administrator.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"
