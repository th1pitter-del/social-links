generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  role          UserRole  @default(USER)
  banned        Boolean   @default(false)
  banReason     String?   @db.Text
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
  links    Link[]
  media    MediaAsset[]
  files    StoredFile[]
  unlocks  UserUnlock[]
  profile  Profile?
  shortLinks ShortLink[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?  @db.Text

  // Set by the better-auth admin plugin when an admin impersonates a user.
  impersonatedBy String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

enum LinkContentType {
  URL
  TEXT
  FILE
}

enum LinkStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum ActionVerification {
  AUTO_PROMPT
  USER_CONFIRMED
  EMAIL_SUBMITTED
}

model Link {
  id           String          @id @default(cuid())
  ownerId      String?
  guestToken   String?
  slug         String          @unique
  title        String
  description  String?         @db.Text
  coverImage   String?         @db.Text
  status       LinkStatus      @default(DRAFT)
  contentType  LinkContentType
  /** Public page theme id from BIO_THEMES; the header and footer use it too. */
  theme        String          @default("pulse")
  targetUrl    String?         @db.Text
  textContent  String?         @db.Text
  fileId       String?
  expiresAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  owner       User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  file        StoredFile?    @relation(fields: [fileId], references: [id], onDelete: SetNull)
  actions     LinkAction[]
  unlocks     UnlockSession[]
  events      AnalyticsEvent[]
  emailLeads  EmailLead[]
  abuseReports AbuseReport[]
  userUnlocks UserUnlock[]

  @@index([ownerId])
  @@index([guestToken])
  @@index([fileId])
}

model LinkAction {
  id            String             @id @default(cuid())
  linkId        String
  type          String
  label         String?
  target        String             @db.Text
  verification  ActionVerification @default(AUTO_PROMPT)
  /** Seconds between opening this step and being allowed to mark it done. Null uses the catalog default. */
  waitSeconds   Int?
  position      Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  link        Link                    @relation(fields: [linkId], references: [id], onDelete: Cascade)
  option      ActionOption            @relation(fields: [type], references: [key], onDelete: Restrict)
  completions UnlockActionCompletion[]
  starts      UnlockActionStart[]
  checkins    TelegramCheckin[]

  @@index([linkId, position])
}

enum UnlockStatus {
  PENDING
  VERIFIED
  EXPIRED
}

model UnlockSession {
  id            String        @id
  linkId        String
  status        UnlockStatus  @default(PENDING)
  ipHash        String?
  userAgent     String?       @db.Text
  referrer      String?       @db.Text
  expiresAt     DateTime
  /** Offers shown as the session's offer step, as [{ id, name }]. Null when OGAds is off. */
  ogadsOffers   Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  link         Link                   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  completions  UnlockActionCompletion[]
  starts       UnlockActionStart[]
  events       AnalyticsEvent[]
  checkins     TelegramCheckin[]
  ogadsClicks  OgadsOfferClick[]

  @@index([linkId])
}

enum OgadsOfferStatus {
  PENDING
  CREDITED
  REVERSED
}

/**
 * A visitor's click-through on one OGAds offer, plus the conversion OGAds later
 * posts back for it. One row per session and offer; the postback updates the row
 * it already has instead of inserting a duplicate.
 */
model OgadsOfferClick {
  id              String            @id @default(cuid())
  unlockSessionId String
  offerId         String
  offerName       String?
  status          OgadsOfferStatus  @default(PENDING)
  payout          Decimal?          @db.Decimal(10, 4)
  clickCount      Int               @default(0)
  firstClickedAt  DateTime?
  creditedAt      DateTime?
  /** The postback's query string, with the shared secret removed. */
  rawPostback     Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  unlockSession UnlockSession @relation(fields: [unlockSessionId], references: [id], onDelete: Cascade)

  @@unique([unlockSessionId, offerId])
  @@index([status, creditedAt])
  @@index([creditedAt])
}

/**
 * The moment a visitor first opened a step that has a waiting period. It is
 * created once per session and action, so reloading or pressing again cannot
 * shorten or restart the wait.
 */
model UnlockActionStart {
  id              String   @id @default(cuid())
  unlockSessionId String
  linkActionId    String
  /** Server-computed deadline; completion is refused before this moment. */
  readyAt         DateTime
  createdAt       DateTime @default(now())

  unlockSession UnlockSession @relation(fields: [unlockSessionId], references: [id], onDelete: Cascade)
  linkAction    LinkAction    @relation(fields: [linkActionId], references: [id], onDelete: Cascade)

  @@unique([unlockSessionId, linkActionId])
  @@index([linkActionId])
}

model UnlockActionCompletion {
  id              String   @id @default(cuid())
  unlockSessionId String
  linkActionId    String
  completedAt     DateTime @default(now())
  /** True when a platform public record or API confirmed the action, not the visitor. */
  verified        Boolean  @default(false)
  /** What the check actually saw, e.g. "octocat follows tekkub". Never shown to visitors. */
  proof           String?  @db.Text

  unlockSession UnlockSession @relation(fields: [unlockSessionId], references: [id], onDelete: Cascade)
  linkAction    LinkAction    @relation(fields: [linkActionId], references: [id], onDelete: Cascade)

  @@unique([unlockSessionId, linkActionId])
}

enum AnalyticsEventType {
  VIEW
  UNLOCK_START
  ACTION_DONE
  UNLOCK_COMPLETE
}

model AnalyticsEvent {
  id              String             @id @default(cuid())
  linkId          String
  unlockSessionId String?
  type            AnalyticsEventType
  ipHash          String?
  userAgent       String?            @db.Text
  referrer        String?            @db.Text
  createdAt       DateTime           @default(now())

  link          Link           @relation(fields: [linkId], references: [id], onDelete: Cascade)
  unlockSession UnlockSession? @relation(fields: [unlockSessionId], references: [id], onDelete: SetNull)

  @@index([linkId, type])
  @@index([linkId, createdAt])
}

model EmailLead {
  id        String   @id @default(cuid())
  linkId    String
  email     String
  consentAt DateTime @default(now())
  createdAt DateTime @default(now())

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, email])
  @@index([linkId])
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

enum AbuseReason {
  SPAM
  MALWARE
  ILLEGAL
  COPYRIGHT
  IMPERSONATION
  OTHER
}

enum AbuseReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model AbuseReport {
  id          String            @id @default(cuid())
  linkId      String
  slug        String
  reason      AbuseReason
  details     String            @db.Text
  reporterEmail String?
  status      AbuseReportStatus @default(OPEN)
  resolutionNote String?        @db.Text
  reporterIpHash String?
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime          @default(now())

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([linkId])
}

model Setting {
  key       String @id
  value     String @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Admin-managed ad unit rendered in a fixed slot across the public site
// (homepage, unlock pages, bio pages) and the creator dashboard.
model AdUnit {
  id        String  @id @default(cuid())
  name      String
  placement String
  type      String
  label     String?
  url       String? @db.Text
  imageUrl  String? @db.Text
  html      String? @db.Text
  newTab    Boolean @default(true)
  enabled   Boolean @default(true)
  position  Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, position])
}

// Admin-managed link shown in the public site header menu on every page.
// labelKey rows are built-in menus whose label comes from the nav translations.
// parentId turns a link into a sub-link of a top-level menu (one level deep).
model HeaderLink {
  id        String   @id @default(cuid())
  label     String
  labelKey  String?
  url       String   @db.Text
  icon      String   @default("link")
  color     String?
  newTab    Boolean  @default(true)
  enabled   Boolean  @default(true)
  position  Int      @default(0)
  parentId  String?
  /** Per-locale label overrides (`{ en, es, 'pt-br', ar }`) for this menu row. */
  labels    Json?
  /** Seeded menus keep their catalog key; the admin editor renders them read-only. */
  builtIn   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   HeaderLink?  @relation("HeaderLinkChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children HeaderLink[] @relation("HeaderLinkChildren")

  @@index([position])
  @@index([parentId, position])
}

enum CustomPageStatus {
  DRAFT
  PUBLISHED
}

/// Admin-authored page opened from the dashboard sidebar. The stored HTML is
/// sanitized on save and again on render; drafts are hidden from regular users.
model CustomPage {
  id            String           @id @default(cuid())
  title         String
  slug          String           @unique
  excerpt       String?          @db.Text
  content       String           @db.LongText
  status        CustomPageStatus @default(DRAFT)
  featuredImage String?          @db.Text
  /** Per-locale overrides `{ es: { title, excerpt, content } }`; empty locales fall back to English. */
  translations  Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  menuItems CustomMenuItem[]

  @@index([status])
}

/// One row in the extra dashboard sidebar section. One level deep: null
/// parentId is a top-level menu, children point at a top-level parent. A row
/// without a page is only valid when it has children (an expandable group).
model CustomMenuItem {
  id        String   @id @default(cuid())
  parentId  String?
  pageId    String?
  title     String
  /** Per-locale label overrides (`{ en, es, 'pt-br', ar }`). */
  labels    Json?
  icon      String   @default("link")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   CustomMenuItem?  @relation("CustomMenuItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children CustomMenuItem[] @relation("CustomMenuItemChildren")
  page     CustomPage?      @relation(fields: [pageId], references: [id], onDelete: Restrict)

  @@index([parentId, sortOrder])
  @@index([pageId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String?
  actorEmail String?
  action    String
  targetType String?
  targetId   String?
  details   String?  @db.Text
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetType, targetId])
}

enum ActionBehavior {
  URL
  EMAIL
}

model Platform {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  icon      String   @default("globe")
  enabled   Boolean  @default(true)
  position  Int      @default(0)
  system    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actionOptions ActionOption[]

  @@index([position])
}

model ActionOption {
  key       String         @id
  label     String
  platformId String?
  platform  Platform?      @relation(fields: [platformId], references: [id], onDelete: SetNull)
  icon      String         @default("link")
  behavior  ActionBehavior @default(URL)
  enabled   Boolean        @default(true)
  position  Int            @default(0)
  system    Boolean        @default(false)
  updatedBy String?
  updatedAt DateTime       @updatedAt

  actions LinkAction[]

  @@index([position])
  @@index([platformId])
}

model MediaAsset {
  id        String   @id @default(cuid())
  ownerId   String
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model StoredFile {
  id        String   @id @default(cuid())
  ownerId   String
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  links Link[]

  @@index([ownerId])
}

model UserUnlock {
  id         String   @id @default(cuid())
  userId     String
  linkId     String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([userId, linkId])
  @@index([userId, unlockedAt])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  handle      String   @unique
  displayName String?
  bio         String?  @db.Text
  avatarUrl   String?  @db.Text
  /** Link-in-bio palette preset; see src/lib/bio-themes.ts. */
  theme       String   @default("pulse")
  /** Optional #RRGGBB override for buttons and highlights. */
  accent      String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  links BioLink[]

  @@index([handle])
}

model BioLink {
  id        String   @id @default(cuid())
  profileId String
  label     String
  url       String   @db.Text
  /** Brand slug from src/lib/bio-platforms.ts; null for a custom link. */
  platform  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
}

/**
 * One visit to the bot's /start deep link. The id is the payload only the
 * server knows, so the account that presses Start cannot be forged by the
 * visitor, and the membership read happens against Telegram's own record.
 */
model TelegramCheckin {
  id              String   @id
  unlockSessionId String
  linkActionId    String
  chatId          String
  /** The Telegram account that actually opened the bot, once its update is read. */
  userId          String?
  username        String?
  memberStatus    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime

  unlockSession UnlockSession @relation(fields: [unlockSessionId], references: [id], onDelete: Cascade)
  linkAction    LinkAction    @relation(fields: [linkActionId], references: [id], onDelete: Cascade)

  @@index([unlockSessionId])
}
enum ShortLinkStatus {
  ACTIVE
  DISABLED
}

/**
 * A plain redirect short link, independent of the unlock product: no steps, no
 * sessions and no analytics beyond a click counter.
 */
model ShortLink {
  id          String          @id @default(cuid())
  ownerId     String
  code        String          @unique
  targetUrl   String          @db.Text
  status      ShortLinkStatus @default(ACTIVE)
  clicks      Int             @default(0)
  lastClickAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}
